<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <ScrollView
            android:id="@+id/main_scroll_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="@drawable/ui_background"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="16dp">

                <Space android:layout_width="match_parent" android:layout_height="24dp" />

                <!-- STATUS SLIDERS PANEL -->
                <LinearLayout
                    android:id="@+id/status_sliders_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="#80000000"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Not Monitoring"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_gravity="center_horizontal" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sensitivity_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0.0"
                        android:valueTo="100.0"
                        android:stepSize="1.0"
                        android:value="75.0" />
                    <com.google.android.material.slider.Slider
                        android:id="@+id/interval_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="1.0"
                        android:valueTo="30.0"
                        android:stepSize="1.0"
                        android:value="5.0" />
                </LinearLayout>

                <!-- CAMERA VIEWPORT GRID -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/camera1Card"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        app:cardCornerRadius="12dp">
                        <ImageView android:id="@+id/cam1Window" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/blank_i" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/camera2Card"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        app:cardCornerRadius="12dp">
                        <ImageView android:id="@+id/cam2Window" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/blank_i" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/camera3Card"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        app:cardCornerRadius="12dp">
                        <ImageView android:id="@+id/cam3Window" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/blank_i" />
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/camera4Card"
                        android:layout_width="0dp"
                        android:layout_height="160dp"
                        android:layout_columnWeight="1"
                        android:layout_rowWeight="1"
                        app:cardCornerRadius="12dp">
                        <ImageView android:id="@+id/cam4Window" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/blank_i" />
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>

                <!-- SERVER COOLDOWN MANAGEMENT PANEL -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCooldownValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="New Cooldown Period (seconds)"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            app:passwordToggleEnabled="true">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAdminPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Admin Password"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <Button
                            android:id="@+id/btnSaveCooldown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Update Cooldown Settings" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LOGOUT BUTTON -->
                <Button
                    android:id="@+id/logoutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="30dp" />

            </LinearLayout>
        </ScrollView>

        <!-- LOGIN INTERFACE -->
        <LinearLayout
            android:id="@+id/login_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/light_blue">

            <AutoCompleteTextView
                android:id="@+id/aliasDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Select Saved Connection"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/aliasDropdownLayoutParent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/newAliasEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Alias Name" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cloudflareTunnelUrlEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cloudflare Tunnel URL" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/newApiKeyEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API Key"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/piM2mSimNumberEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pi M2M SIM Number"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/client_phone_number_entry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Client Phone Number (for SMS)"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/saveConnectionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save Connection"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/resetLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Fields" />

        </LinearLayout>

        <!-- LOADING GIF OVERLAY -->
        <FrameLayout
            android:id="@+id/loading_overlay_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone">
            <ImageView
                android:id="@+id/hornbillLoadingGif"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- ⚡ TRUE FLOATING ALERT BANNER (MOVED TO ROOT FRAME_LAYOUT OVERLAY) -->
        <LinearLayout
            android:id="@+id/alert_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#D32F2F"
            android:elevation="10dp"
            android:visibility="gone">

            <!-- ⚡ SWITCHED TO WEBVIEW FOR STREAM SUPPORT -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">
                <ImageView
                    android:id="@+id/alert_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/blank_i" />
                <WebView
                    android:id="@+id/alert_webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/alert_details_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                tools:text="ALERT! Detected Animal." />

            <Button
                android:id="@+id/btnDismissAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OK / DISMISS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C"
                android:textStyle="bold" />
        </LinearLayout>

    </FrameLayout>
</layout>